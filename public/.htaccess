# =====================================================================
#  Society Harmony Hub — Apache config for the society.gaugecalpro.com
#  subdomain (docroot: public_html/society/)
#
#  WHY THIS FILE MATTERS
#    The app is a single-page application. The server only really has
#    index.html. When someone refreshes on /income, Apache looks for a
#    folder called "income", does not find one, and returns 404. This
#    file tells Apache: if the path is not a real file or folder, serve
#    index.html and let React Router work out the rest.
#
#  IF IT IS MISSING, EVERY REFRESH ON ANY PAGE IS A 404.
#  It is a hidden file (the name starts with a dot), so it is easy to
#  lose when uploading or extracting a zip. Always turn on "show hidden
#  files" in the Hostinger File Manager after deploying and check that
#  it is there.
# =====================================================================

# Do not let Apache guess /income means /income.php etc.
Options -MultiViews

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The app is served from the root of this subdomain.
  # If it is ever moved under a path instead (e.g. gaugecalpro.com/society/),
  # this must become: RewriteBase /society/
  RewriteBase /

  # 1. Leave the PHP API completely alone — uploads, file serving, cron.
  RewriteRule ^api/ - [L]

  # 2. Anything that really exists on disk is served as-is
  #    (assets, favicon, robots.txt, uploaded files).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Everything else is an app route -> hand it to React Router.
  RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------------
#  Caching
#
#  Vite puts a content hash in every asset filename (index-CS9yu17t.js),
#  so those can be cached hard and for a long time — a new build has a
#  new name. index.html must NEVER be cached, or the browser keeps
#  loading yesterday's app after a deploy and you chase bugs that are
#  already fixed.
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^(index\.html|service-worker\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    image/svg+xml font/woff font/woff2
</IfModule>

# ---------------------------------------------------------------------
#  Keep configuration and source maps out of reach.
# ---------------------------------------------------------------------
<IfModule mod_authz_core.c>
  <FilesMatch "(^\.|\.(env|ini|log|sh|sql|bak|map)$)">
    Require all denied
  </FilesMatch>
</IfModule>
